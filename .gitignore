# --- Editor / OS junk ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Secrets & credentials ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# --- Logs & caches ---
*.log
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
node_modules/

# --- Scratch / temp files (never commit) ---
tmp/
.tmp/
*.tmp
scratch/

# --- Generated data (scanner output, never commit) ---
*.db
data/db/

# --- Scanned papers (your own files, never commit) ---
pdf/
data/inbox/*.pdf